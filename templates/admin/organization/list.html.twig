{% extends "base.html.twig" %}

{% block body %}
<div class="container">
    <div class="row py-5">
        <div class="col">
            <a href={{ path("organizations_add") }} class="btn btn-primary">Add New</a>
            {% if ( organizations is defined ) and (organizations > -1 ) %}
            <ul class="list-group py-3">
                {% for organization in organizations %}
                <li class="list-grop-item my-2">
                <h3>{{ organization.name }}</h3>
                <div class="btn-group">
                    <a class='btn btn-primary' href="{{ path("tickets_list_organization", {id: organization.id}) }}">Tickets</a>
                    <a class='btn btn-secondary' href="{{ path("organizations_edit", {id: organization.id}) }}">Edit</a>
                </div>
                </li>
                {% endfor %}
            </ul>
            {% endif %}

        </div>
    </div>
</div>

{% endblock %}