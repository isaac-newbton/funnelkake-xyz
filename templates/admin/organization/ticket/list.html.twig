{% extends "base.html.twig" %}

{% block body %}
<div class="container">
    <div class="row my-3">
        <div class="col">
            <div class="btn-group">
                {# TODO: <a href="{{ path("tickets_list") }}" class="btn btn-primary">Open</a>
                <a href="{{ path("tickets_list_closed") }}" class="btn btn-secondary">Closed</a> #}
            </div>
        </div>
    </div>
    <div class="row my-3">
        <div class="col">
        {% for ticket in tickets %}
            <div class="card my-3">
                <div class="card-header text-muted">
                    <span>
                        {{ticket.email}}
                    </span>
                    <span class="float-right ticket-{{ticket.getStatusText}}">
                        {{ticket.getStatusText}}
                    </span>
                </div>
                <div class="card-body">
                    <h5 class="card-title">
                        <a href="{{ path("tickets_single", {id: ticket.id}) }}">{{ticket.subject}}</a>
                        <span class="badge badge-primary badge-pill">{{ ticket.comment|length}}</span>
                    </h5>
                    <span class="float-right">
                    {% if ticket.organization.name is defined %}
                    {{ticket.organization.name}}
                    {% endif %}
                    </span>
                </div>
            </div>
        {% endfor %}
        </div>
    </div>
</div>

{% endblock %}