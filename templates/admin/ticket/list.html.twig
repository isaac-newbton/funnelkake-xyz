{% extends "base.html.twig" %}

{% block body %}
<div class="container">
    <div class="row">
        <div class="col">
        {% for ticket in tickets %}
            <div class="card my-3">
                <div class="card-header text-muted">
                    <span>
                        {{ticket.email}}
                    </span>
                    <span class="float-right">
                        {{ ticket.timestamp|date('d/m/Y h:i A') }}
                    </span>
                </div>
                <div class="card-body">
                    <h5 class="card-title"><a href="#">{{ticket.subject}}</a></h5>
                    {{ticket.content|raw}}
                </div>
                <div class="card-footer">
                    <span class="float-right">
                    {% if ticket.organization.name is defined %}
                    {{ticket.organization.name}}
                    {% else %}
                    <a href="#" class="btn-link">Assign Organization</a>
                    {% endif %}
                    </span>
                </div>
            </div>
        {% endfor %}
        </div>
    </div>
</div>
{% endblock %}