{% extends "base.html.twig" %}

{% set assignOrganization = "<button class='btn btn-link' data-toggle='modal' data-target='#ticket-organization-modal'>Assign Organization</button>" %}

{% block body %}
<div class="container">
    <div class="row my-3">
        <div class="col">
            <div class="card">
                <h5 class="card-header">{{ ticket.email }} <strong class="float-right">{{ticket.organization.name ?? assignOrganization|raw }}</strong></h5>
                <div class="card-body">
                    {{ ticket.subject }} 
                </div>
            </div>
        </div>
    </div>
    <div class="row my-1">
        <div class="col">
            <div class="btn-group">
                <button class="btn-sm btn-primary" type="button" data-toggle="collapse" data-target="#collapseExample" aria-expanded="false" aria-controls="collapseExample">
                    Add Reply
                  </button>
                <a href="#" class="btn btn-sm btn-secondary">Close Ticket</a>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col">
            <div class="collapse py-5" id="collapseExample">
                    {{ form_start(form) }}
                    {{ form_row(form.content, { label: "Reply" })}}
                    <input type="submit" class="btn btn-primary" value="Submit">
                    {{ form_end(form) }}
            </div>
        </div>
    </div>

    {% for comment in ticket.comment|reverse %}
    <div class="row my-3">
        <div class="col">
            <div class="card bg-white">
                <div class="card-body">
                    <p class="muted">{{ comment.user.email|default(null)}} {{ comment.timestamp|date('d/m/Y h:i A')}}</p>
                    {{ comment.content }}
                </div>
            </div>
        </div>
    </div>
    {% endfor %}
</div>

<!-- ticket-organization-modal -->
<div class="modal fade" id="ticket-organization-modal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Assign Organization</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form action="">
                    <select class="form-control" name="" id="">
                        <option value="">orgs go here</option>
                    </select>
                </form>
            </div>
        </div>
    </div>
</div>

{% endblock %}