{% extends "base.html.twig" %}

{% set assignOrganization = "<button class='btn btn-link assign-ticket' data-toggle='modal' data-target='#ticket-organization-modal'>Assign Organization</button>" %}

{% block body %}
<div class="container">
    <div class="row my-3">
        <div class="col">
            <div class="card">
                <div class="card-header">
                    <span class="badge badge-dark">{{ ticket.email }}</span>
                    <span class="float-right">
                        <strong>{{ticket.organization.name ?? assignOrganization|raw }}</strong>
                        <span>{{ ticket.getStatusText|default('open') }}</span>
                    </span>
                </div>
                <div class="card-body">
                    {{ ticket.subject }} 
                </div>
            </div>
        </div>
    </div>
    {% if ticket.mediaFiles is not empty %}
    <div class="row my-1">
        <div class="col">
            <h3>Files</h3>
            <div class="row">
                {% for file in ticket.mediaFiles %}
                    <div class="col-3 mb-3">
                        <div class="p-3 shadow-sm">
                            {% include "media/single_file_item.html.twig" %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
    {% endif %}
    <div class="row my-1">
        <div class="col">
            <div class="btn-group">
                <button class="btn-sm btn-primary" type="button" data-toggle="collapse" data-target="#collapseExample" aria-expanded="false" aria-controls="collapseExample">
                    Add Reply
                  </button>
                  {% if ticket.getStatusText == 'closed' %}
                      <a href="{{ path("tickets_open", {id: ticket.id}) }}" class="btn btn-sm btn-success">Reopen Ticket</a>
                  {% else %}
                  <a href="{{ path("tickets_close", {id: ticket.id}) }}" class="btn btn-sm btn-secondary" onclick="return confirm('Are you sure you want to close this ticket?')">Close Ticket</a>
                  {% endif %}
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col">
            <div class="collapse py-5" id="collapseExample">
                    {{ form_start(commentForm) }}
                    {{ form_row(commentForm.content, { label: "Reply" })}}
                    <input type="submit" class="btn btn-primary" value="Submit">
                    {{ form_end(commentForm) }}
            </div>
        </div>
    </div>

    {% for comment in ticket.comment|reverse %}
    <div class="row my-3">
        <div class="col">
            <div class="card bg-white">
                <div class="card-header">
                    <span class="badge badge-dark">{{ comment.user.email|default(null)}}</span>
                </div>
                <div class="card-body">
                    <p class="small">{{ comment.timestamp|date('m/d/Y h:ia')}}</p>
                    <p>{{ comment.content|raw }}</p>
                </div>
            </div>
        </div>
    </div>
    {% endfor %}
</div>

<!-- ticket-organization-modal -->
<div class="modal fade" id="ticket-organization-modal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Assign Organization</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                {{ form_start(ticketOrganizationForm) }}
                {{ form_row(ticketOrganizationForm.ticket)}}
                {{ form_row(ticketOrganizationForm.organization)}}
                {{ form_row(ticketOrganizationForm.submit)}}
                {{ form_widget(ticketOrganizationForm._token)}}
                {{ form_end(ticketOrganizationForm, {render_rest: false})}}
            </div>
        </div>
    </div>
</div>

{# ugly js goes here until we find a better way to handle it #}
<script>
    jQuery(document).ready(function($){
        $(".assign-ticket").click(function(){
            $('input[name="ticket[ticket]"]').prop('value', {{ ticket.id }})
        })
    })
</script>
{% endblock %}