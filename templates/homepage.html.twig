{% extends "base.html.twig" %}
{% block body %}
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <h1>Homepage</h1>
                <p>This is the homepage...</p>
                {% if is_granted('IS_AUTHENTICATED_REMEMBERED') %}
                    <a href="{{logout_url(null)}}" class="btn btn-outline-primary">Logout</a>
                {% else %}
                    <a href="{{path('app_login')}}" class="btn btn-primary btn-lg">Login</a>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
